# Copy this file to .env and adjust as needed. Every value has a safe default
# in lib/env.ts, so the playground runs with no .env at all. Set these before
# exposing the MCP server to anyone you do not trust.

# Shared HMAC secret used to sign and verify the MCP JWT (HS256).
# Leave unset to use the built-in demo secret (fine for local play, never prod).
JWT_SECRET=

# Claims the server expects on incoming tokens. The startup banner mints a
# token with exactly these values, so only change them if you bring your own.
JWT_ISSUER=https://playground.routecraft.dev
JWT_AUDIENCE=https://mcp.routecraft.dev

# Where the MCP HTTP server binds. PORT takes precedence so cloud dev boxes
# (CodeSandbox, Codespaces) can expose the preview URL automatically.
PORT=3001
MCP_HOST=0.0.0.0

# Public URL of the MCP server, shown in the startup banner. Auto-detected on
# CodeSandbox and Codespaces; set this to override (e.g. behind a custom proxy).
# MCP_PUBLIC_URL=https://your-box-3001.example.dev

# Embedding model for the semantic notes search, as "provider:model".
# Defaults to an in-process HuggingFace model (downloads once on first use).
# Use "mock:fast" for a deterministic, zero-download stub.
EMBEDDING_MODEL=huggingface:all-MiniLM-L6-v2

# Where the error-collector capability appends failure events as JSONL.
ERROR_LOG_PATH=errors.jsonl
