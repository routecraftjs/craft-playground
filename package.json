{
  "name": "craft-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "craft --log-level info run index.ts",
    "inspect": "bun scripts/inspect.ts",
    "token": "bun scripts/print-token.ts",
    "lint": "eslint .",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "EMBEDDING_MODEL=mock:test ERROR_LOG_PATH=/tmp/craft-playground-test-errors.jsonl bun test",
    "test:coverage": "EMBEDDING_MODEL=mock:test ERROR_LOG_PATH=/tmp/craft-playground-test-errors.jsonl bun test --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@routecraft/ai": "0.6.0",
    "@routecraft/routecraft": "0.6.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@routecraft/cli": "0.6.0",
    "@routecraft/eslint-plugin-routecraft": "0.6.0",
    "@routecraft/testing": "0.6.0",
    "@types/node": "^25.9.5",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
