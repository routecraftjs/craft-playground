{
  "name": "craft-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "craft --log-level info run index.ts",
    "lint": "eslint .",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@routecraft/routecraft": "0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@routecraft/cli": "0.5.0",
    "@routecraft/eslint-plugin-routecraft": "0.5.0",
    "@routecraft/testing": "0.5.0",
    "@types/node": "^25.5.0",
    "bun-types": "^1.1.0",
    "eslint": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
