{
  "name": "craft-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "craft run index.ts --log-level info",
    "lint": "eslint .",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@routecraft/routecraft": "0.3.0",
    "up": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@routecraft/cli": "^0.3.0",
    "@routecraft/eslint-plugin-routecraft": "^0.3.0",
    "@routecraft/testing": "0.3.0",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "@routecraft/routecraft": "0.3.0",
      "@routecraft/testing": "0.3.0"
    }
  }
}
